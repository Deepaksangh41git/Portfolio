# ---------- Vercel (Project → Settings → Environment Variables) ----------
GEMINI_API_KEY=your-ai-studio-key
GROQ_API_KEY=gsk_...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # or the legacy "anon" key
ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app,http://localhost:5500
# optional
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
CONTACT_EMAIL=deepaksangh45@gmail.com
RATE_LIMIT_PER_MIN=8

# ---------- GitHub Actions (repo → Settings → Secrets and variables → Actions) ----------
# Secrets: GEMINI_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY (sb_secret_... or legacy service_role)
# Variables (optional): PORTFOLIO_REPO=Portfolio, SKIP_REPOS=repo-a,repo-b
